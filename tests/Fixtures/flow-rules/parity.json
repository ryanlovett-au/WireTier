  "central_default": {
    "source": "# This is a default rule set that allows IPv4 and IPv6 traffic but otherwise\n# behaves like a standard Ethernet switch.\n\n#\n# Allow only IPv4, IPv4 ARP, and IPv6 Ethernet frames.\n#\ndrop\n\tnot ethertype ipv4\n\tand not ethertype arp\n\tand not ethertype ipv6\n;\n\n# Accept anything else. This is required since default is 'drop'.\naccept;\n",
    "rules": [
      {
        "type": "MATCH_ETHERTYPE",
        "not": true,
        "or": false,
        "etherType": 2048
      },
      {
        "type": "MATCH_ETHERTYPE",
        "not": true,
        "or": false,
        "etherType": 2054
      },
      {
        "type": "MATCH_ETHERTYPE",
        "not": true,
        "or": false,
        "etherType": 34525
      },
      {
        "type": "ACTION_DROP"
      },
      {
        "type": "ACTION_ACCEPT"
      }
    ],
    "capabilities": {},
    "tags": {}
  },
  "capabilities_and_tags_example": {
    "source": "# Drop all Ethernet frame types that are not IPv4 or IPv6\ndrop\n\tnot ethertype 0x0800 # IPv4\n\tnot ethertype 0x0806 # IPv4 ARP\n\tnot ethertype 0x86dd # IPv6\n;\n\n# Capability: outgoing SSH\ncap ssh\n\tid 1000\n\taccept\n\t\tipprotocol tcp\n\t\tdport 22\n\t;\n;\n\n# A tag indicating which department people belong to\ntag department\n\tid 1000\n\tenum 100 sales\n\tenum 200 marketing\n\tenum 300 accounting\n\tenum 400 engineering\n;\n\n# Accept all traffic between members of the same department\naccept\n\ttdiff department 0\n;\n\naccept;\n",
    "rules": [
      {
        "type": "MATCH_ETHERTYPE",
        "not": true,
        "or": false,
        "etherType": 2048
      },
      {
        "type": "MATCH_ETHERTYPE",
        "not": true,
        "or": false,
        "etherType": 2054
      },
      {
        "type": "MATCH_ETHERTYPE",
        "not": true,
        "or": false,
        "etherType": 34525
      },
      {
        "type": "ACTION_DROP"
      },
      {
        "type": "MATCH_TAGS_DIFFERENCE",
        "not": false,
        "or": false,
        "id": 1000,
        "value": 0
      },
      {
        "type": "ACTION_ACCEPT"
      },
      {
        "type": "ACTION_ACCEPT"
      }
    ],
    "capabilities": {
      "ssh": {
        "id": 1000,
        "default": false,
        "rules": [
          {
            "type": "MATCH_IP_PROTOCOL",
            "not": false,
            "or": false,
            "ipProtocol": 6
          },
          {
            "type": "MATCH_IP_DEST_PORT_RANGE",
            "not": false,
            "or": false,
            "start": 22,
            "end": 22
          },
          {
            "type": "ACTION_ACCEPT"
          }
        ]
      }
    },
    "tags": {
      "department": {
        "id": 1000,
        "default": null,
        "enums": {
          "sales": 100,
          "marketing": 200,
          "accounting": 300,
          "engineering": 400
        },
        "flags": {}
      }
    }
  },
